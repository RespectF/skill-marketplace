{
  "builds": [
    {
      "src": "vercel-api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/vercel-api/index.js"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/dist/public/index.html"
    }
  ],
  "installCommand": "pnpm install --no-frozen-lockfile"
}
