{
  "builds": [
    {
      "src": "dist/api-handler.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/dist/api-handler.js"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/dist/public/index.html"
    }
  ]
}
